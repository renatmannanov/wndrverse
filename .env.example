# Community brain (core/) — copy to .env and fill in.
DATABASE_URL=postgresql://postgres:localpass@localhost:5434/wndrverse
OPENAI_API_KEY=
# Directory with telegram-gather exports (wndr_topic_*.json). No trailing slash.
WNDR_EXPORTS_DIR=

# Realtime ingest bot (bot/ingest_bot.py)
# Bot token from @BotFather — separate from the curator's BOT_TOKEN. Do NOT confuse them.
BOT_TOKEN_INGEST=
# Path to the (chat_id, thread_id) -> topic config. Default: core/ingest/topic_map.json
WNDR_TOPIC_MAP=
