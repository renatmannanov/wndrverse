# Community brain (core/) — copy to .env and fill in.
DATABASE_URL=postgresql://postgres:localpass@localhost:5434/wndrverse
OPENAI_API_KEY=
# Directory with telegram-gather exports (wndr_topic_*.json). No trailing slash.
WNDR_EXPORTS_DIR=

# Realtime ingest bot (bot/ingest_bot.py)
# Bot token from @BotFather — separate from the curator's BOT_TOKEN. Do NOT confuse them.
BOT_TOKEN_INGEST=
# Path to the (chat_id, thread_id) -> topic config. Default: core/ingest/topic_map.json
WNDR_TOPIC_MAP=

# Digest delivery (delivery/channels.py telegram_dm)
# Telegram user_id to DM the digest to. User must /start the ingest bot first
# (Telegram won't let a bot message a user who hasn't started it).
WNDR_DIGEST_DM_USER_ID=

# Digest scheduler (digest/scheduler.py) — all optional, defaults shown.
WNDR_DIGEST_TZ=Asia/Almaty
WNDR_DIGEST_AT=09:00
WNDR_DIGEST_PERIOD=1d
WNDR_DIGEST_TOPICS=questions_to_women,questions_to_men
