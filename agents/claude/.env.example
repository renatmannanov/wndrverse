# Agent: Claude (Claude Agent SDK via Max OAuth)
#
# Copy this file to `.env` in the same folder and fill the values.
# This file lives ONLY in agents/claude/. It is NOT shared with other agents.

# Telegram bot for this agent (created via @BotFather, must be added to the supergroup)
AGENT_CLAUDE_TOKEN=

# Telegram supergroup with the Bus topic
GROUP_CHAT_ID=
BUS_TOPIC_ID=

# Whom this agent represents (telegram username from members.json, no @)
OWNER_USERNAME=

# Optional: Telethon (for reading Telegram channels directly, MVP doesn't need it)
# TG_API_ID=
# TG_API_HASH=
# TG_TELETHON_SESSION=.local/telethon.session

# DO NOT put ANTHROPIC_API_KEY here.
# This agent uses Claude Code OAuth (`claude login`), not the API.
# If ANTHROPIC_API_KEY ends up in env, the SDK may bill via API instead of subscription.
